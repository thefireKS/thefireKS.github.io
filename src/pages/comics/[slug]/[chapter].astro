---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import type { ComicChapterEntry, ComicEntry } from "$api/comics";
import BaseLayout from "$components/layouts/base-layout.astro";
import {
  compareChaptersAsc,
  formatComicDate,
  getChapterHref,
  getChapterSlug,
  getComicHref,
} from "$api/comics";

interface Props {
  comic: ComicEntry;
  chapterEntry: ComicChapterEntry;
  chapters: ComicChapterEntry[];
  previousChapter: ComicChapterEntry | null;
  nextChapter: ComicChapterEntry | null;
}

export async function getStaticPaths() {
  const [comics, allChapters] = await Promise.all([
    getCollection("comics"),
    getCollection("comicChapters"),
  ]);

  return allChapters.flatMap((chapter) => {
    const comic = comics.find((entry) => entry.id === chapter.data.comic);

    if (!comic) {
      return [];
    }

    const chapters = allChapters
      .filter((entry) => entry.data.comic === chapter.data.comic)
      .sort(compareChaptersAsc);
    const currentIndex = chapters.findIndex((entry) => entry.id === chapter.id);

    return [
      {
        params: {
          slug: chapter.data.comic,
          chapter: getChapterSlug(chapter),
        },
        props: {
          comic,
          chapterEntry: chapter,
          chapters,
          previousChapter: currentIndex > 0 ? chapters[currentIndex - 1] : null,
          nextChapter:
            currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null,
        },
      },
    ];
  });
}

const { comic, chapterEntry, chapters, previousChapter, nextChapter } =
  Astro.props as Props;

const pageCountLabel = chapterEntry.data.pages.length === 1 ? "page" : "pages";
const buttonBaseClass =
  "inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm uppercase tracking-[0.15em]";
---

<BaseLayout
  theme="comics"
  siteMainTitle={`${comic.data.title} | Chapter ${chapterEntry.data.chapterNumber}`}
>
  <section class="space-y-5">
    <div class="flex flex-wrap items-center gap-3">
      <a
        href={getComicHref(comic)}
        class={`${buttonBaseClass} border border-highlight text-white/80 hover:bg-surface-hover`}
      >
        <Icon name="pixelarticons:arrow-left" class="text-base text-brand" />
        Series page
      </a>

      {
        previousChapter ? (
          <a
            href={getChapterHref(previousChapter)}
            class={`${buttonBaseClass} border border-highlight text-white/80 hover:bg-surface-hover`}
          >
            <Icon name="pixelarticons:chevron-left" class="text-base text-brand" />
            Prev
          </a>
        ) : null
      }

      {
        nextChapter ? (
          <a
            href={getChapterHref(nextChapter)}
            class={`${buttonBaseClass} bg-brand font-bold text-black`}
          >
            Next
            <Icon name="pixelarticons:chevron-right" class="text-base" />
          </a>
        ) : null
      }
    </div>

    <section class="rounded-[1.5rem] border-2 border-highlight bg-surface-hover p-5">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-2">
          <p class="text-xs uppercase tracking-[0.2em] text-white/60">
            {comic.data.title}
          </p>
          <h1 class="text-2xl font-heading text-brand-secondary">
            Chapter {chapterEntry.data.chapterNumber}: {chapterEntry.data.title}
          </h1>
          <div class="flex flex-wrap gap-3 text-sm text-white/70">
            <span>{chapterEntry.data.pages.length} {pageCountLabel}</span>
            <span>{formatComicDate(chapterEntry.data.releaseDate)}</span>
          </div>
        </div>

        {
          chapterEntry.data.summary ? (
            <p class="max-w-2xl text-sm leading-relaxed text-white/80">
              {chapterEntry.data.summary}
            </p>
          ) : null
        }
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        {chapters.map((chapter) => {
          const isCurrent = chapter.id === chapterEntry.id;

          return (
            <a
              href={getChapterHref(chapter)}
              aria-current={isCurrent ? "page" : "false"}
              class="rounded-full border border-highlight px-3 py-2 text-xs uppercase tracking-[0.15em] text-white/75 aria-[current='page']:bg-brand aria-[current='page']:text-black"
            >
              Ch. {chapter.data.chapterNumber}
            </a>
          );
        })}
      </div>
    </section>

    <section class="mx-auto max-w-5xl space-y-5">
      {chapterEntry.data.pages.map((page, index) => (
        <figure class="overflow-hidden rounded-[1.5rem] border-2 border-highlight bg-[#0d0d0f] shadow-[0_24px_60px_rgba(0,0,0,0.35)]">
          <Image
            src={page.image}
            alt={
              page.name ??
              `${comic.data.title} chapter ${chapterEntry.data.chapterNumber} page ${index + 1}`
            }
            class="block h-auto w-full"
            loading={index === 0 ? "eager" : "lazy"}
          />
        </figure>
      ))}
    </section>

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-[1.5rem] border-2 border-highlight bg-surface-hover p-4">
      {
        previousChapter ? (
          <a
            href={getChapterHref(previousChapter)}
            class={`${buttonBaseClass} border border-highlight text-white/80 hover:bg-surface`}
          >
            <Icon name="pixelarticons:chevron-left" class="text-base text-brand" />
            Chapter {previousChapter.data.chapterNumber}
          </a>
        ) : (
          <span class="text-sm uppercase tracking-[0.15em] text-white/40">
            First chapter
          </span>
        )
      }

      <a
        href={getComicHref(comic)}
        class={`${buttonBaseClass} border border-highlight text-white/80 hover:bg-surface`}
      >
        <Icon name="pixelarticons:book" class="text-base text-brand" />
        All chapters
      </a>

      {
        nextChapter ? (
          <a
            href={getChapterHref(nextChapter)}
            class={`${buttonBaseClass} bg-brand font-bold text-black`}
          >
            Chapter {nextChapter.data.chapterNumber}
            <Icon name="pixelarticons:chevron-right" class="text-base" />
          </a>
        ) : (
          <span class="text-sm uppercase tracking-[0.15em] text-white/40">
            Latest chapter
          </span>
        )
      }
    </div>
  </section>
</BaseLayout>
