---
import ComicCard from "$components/comic-card.astro";
import ContentContainer from "$components/content-container.astro";
import BaseLayout from "$components/layouts/base-layout.astro";
import { getComicsIndex } from "$api/comics";

const comics = await getComicsIndex();

const totalChapterCount = comics.reduce(
  (sum, entry) => sum + entry.chapters.length,
  0,
);
---

<BaseLayout
  siteMainTitle="Comics"
  theme="comics"
  description="halfwaypixel's comics"
>
  <ContentContainer heading="Comic updates">
    {
      comics.length > 0 ? (
        <p>
          Browse <strong>{comics.length}</strong> comic series and jump into{" "}
          <strong>{totalChapterCount}</strong> published chapters.
        </p>
      ) : (
        <p>
          "No comics :("
        </p>
      )
    }
  </ContentContainer>

  {
    comics.length > 0 ? (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {comics.map((entry) => <ComicCard entry={entry} />)}
      </div>
    ) : (
      <ContentContainer heading="Upload structure">
        <p>
          Create a comic file in <code>src/content/comics</code>, create chapter
          files in <code>src/content/comicChapters/&lt;comic-slug&gt;</code>,
          then drop chapter pages into <code>src/assets/comics/&lt;comic-slug&gt;</code>.
        </p>
      </ContentContainer>
    )
  }
</BaseLayout>
