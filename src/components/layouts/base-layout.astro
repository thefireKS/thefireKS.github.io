---
import "$styles/main.css";
import NavigationBar from "$components/navigation-bar.astro";
import SiteFooter from "$components/site-footer.astro";
import { siteDetails } from "site.config";

interface Props {
  siteMainTitle?: string;
  logoTitle?: string;
  theme?: string;
  description?: string;
  ogImage?: string;
}

const {
  logoTitle = siteDetails.siteTitle,
  siteMainTitle,
  theme,
  description = siteDetails.siteDescription,
  ogImage = siteDetails.ogImage,
} = Astro.props;

const pageTitle = siteMainTitle
  ? `${siteMainTitle} | ${siteDetails.siteTitle}`
  : siteDetails.siteTitle;

/* Link previews and canonical tags only accept absolute URLs, which is what
 * `site` in astro.config.mjs is for. */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteDetails.siteTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="site-shell lg:container mx-auto md:px-0">
    <NavigationBar title={logoTitle} />
    <main
      class="site-main lg:flex-grow bg-surface lg:border-x-2 border-highlight min-h-screen lg:min-h-full"
    >
      <div class="site-main-background" aria-hidden="true">
        <slot name="main-background" />
      </div>
      <div class="site-main-content space-y-8 p-4">
        <slot />
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .site-main {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .site-main-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .site-main-content {
    position: relative;
    z-index: 1;
  }
</style>
