---
type BallTextureAnimationConfig = {
  columns: number;
  rows: number;
  frameCount: number;
  fps: number;
  startFrame: number;
};

type BallTextureDescriptor = {
  name: string;
  url: string;
  animation: BallTextureAnimationConfig | null;
};

interface Props {
  mode?: "default" | "background";
  showHeader?: boolean;
}

const { mode = "default", showHeader = mode !== "background" } = Astro.props;
const isBackground = mode === "background";

const uploadedTextureModules = import.meta.glob(
  "../assets/ball-textures/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);

const uploadedAtlasConfigModules = import.meta.glob(
  "../assets/ball-textures/*.atlas.json",
  { eager: true, import: "default" },
);

function getModuleAssetUrl(moduleValue: unknown) {
  const maybeDefault = (moduleValue as { default?: unknown }).default;

  if (typeof maybeDefault === "string") {
    return maybeDefault;
  }

  if (maybeDefault && typeof maybeDefault === "object" && "src" in maybeDefault) {
    const srcValue = (maybeDefault as { src?: unknown }).src;
    return typeof srcValue === "string" ? srcValue : null;
  }

  return null;
}

function getFileStem(modulePath: string) {
  const normalizedPath = modulePath.replaceAll("\\", "/");
  const fileName = normalizedPath.slice(normalizedPath.lastIndexOf("/") + 1);
  return fileName.replace(/\.[^.]+$/, "");
}

function getAtlasStem(modulePath: string) {
  const normalizedPath = modulePath.replaceAll("\\", "/");
  const fileName = normalizedPath.slice(normalizedPath.lastIndexOf("/") + 1);
  return fileName.replace(/\.atlas\.json$/, "");
}

function toPositiveInteger(value: unknown) {
  if (typeof value !== "number" || !Number.isFinite(value)) {
    return null;
  }

  const normalizedValue = Math.floor(value);
  return normalizedValue > 0 ? normalizedValue : null;
}

function toPositiveNumber(value: unknown) {
  if (typeof value !== "number" || !Number.isFinite(value) || value <= 0) {
    return null;
  }

  return value;
}

function normalizeAtlasConfig(rawConfig: unknown): BallTextureAnimationConfig | null {
  if (!rawConfig || typeof rawConfig !== "object") {
    return null;
  }

  const config = rawConfig as Record<string, unknown>;
  const columns = toPositiveInteger(config.columns);
  const rows = toPositiveInteger(config.rows);

  if (!columns || !rows) {
    return null;
  }

  const maxFrameCount = columns * rows;
  const frameCount = Math.min(
    toPositiveInteger(config.frameCount) ??
      toPositiveInteger(config.totalFrames) ??
      maxFrameCount,
    maxFrameCount,
  );
  const fps = toPositiveNumber(config.fps) ?? 24;
  const startFrame = Math.min(
    Math.max(
      typeof config.startFrame === "number" && Number.isFinite(config.startFrame)
        ? Math.floor(config.startFrame)
        : 0,
      0,
    ),
    frameCount - 1,
  );

  return {
    columns,
    rows,
    frameCount,
    fps,
    startFrame,
  };
}

const atlasConfigByTextureName = new Map(
  Object.entries(uploadedAtlasConfigModules)
    .map(([modulePath, rawConfig]) => [
      getAtlasStem(modulePath),
      normalizeAtlasConfig(rawConfig),
    ])
    .filter(
      (
        entry,
      ): entry is [string, BallTextureAnimationConfig] => entry[1] !== null,
    ),
);

const ballTextureDescriptors: BallTextureDescriptor[] = Object.entries(
  uploadedTextureModules,
)
  .map(([modulePath, moduleValue]) => {
    const url = getModuleAssetUrl(moduleValue);

    if (!url) {
      return null;
    }

    const name = getFileStem(modulePath);
    return {
      name,
      url,
      animation: atlasConfigByTextureName.get(name) ?? null,
    };
  })
  .filter((descriptor): descriptor is BallTextureDescriptor => descriptor !== null)
  .sort((left, right) => left.name.localeCompare(right.name));
---

<section
  class:list={["scene-wrapper", isBackground && "scene-wrapper--background"]}
  aria-hidden={isBackground ? "true" : undefined}
>
  {
    showHeader && (
      <header class="scene-header">
        <h1>Emoticons Scene Prototype</h1>
        <p>
          Garage-style door, thin container geometry, real physics, and ball
          textures loaded from <code>src/assets/ball-textures</code>. Add an
          optional <code>&lt;texture-name&gt;.atlas.json</code> next to a sheet
          when it should animate.
        </p>
      </header>
    )
  }

  <div class="scene-stage">
    <div
      class="scene-host"
      data-emoticons-scene-host
      data-scene-mode={mode}
      data-textures={JSON.stringify(ballTextureDescriptors)}
    ></div>
  </div>
</section>

<script type="module">
  import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.module.js";

  const hosts = document.querySelectorAll("[data-emoticons-scene-host]");
  for (const host of hosts) {
    if (host.dataset.initialized === "true") {
      continue;
    }

    host.dataset.initialized = "true";
    initScene(host);
  }

  function initScene(hostEl) {
    const textureDescriptors = JSON.parse(hostEl.dataset.textures || "[]");
    const sceneMode = hostEl.dataset.sceneMode || "default";
    const isBackground = sceneMode === "background";

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(hostEl.clientWidth, hostEl.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    hostEl.append(renderer.domElement);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x322a2a);
    scene.fog = new THREE.Fog(0x322a2a, 10, 26);

    const camera = new THREE.PerspectiveCamera(
      44,
      hostEl.clientWidth / hostEl.clientHeight,
      0.1,
      100,
    );

    if (isBackground) {
      camera.position.set(0, 2.5, 8.2);
      camera.lookAt(0, 0.7, 1.0);
    } else {
      camera.position.set(0, 2.1, 7.2);
      camera.lookAt(0, 0.7, 0.6);
    }

    const ambient = new THREE.AmbientLight(0xffffff, 0.48);
    scene.add(ambient);

    const hemiLight = new THREE.HemisphereLight(0xffcdb2, 0x12061f, 0.45);
    scene.add(hemiLight);

    const keyLightTarget = new THREE.Object3D();
    keyLightTarget.position.set(0, 0.7, 1.7);
    scene.add(keyLightTarget);

    const keyLight = new THREE.DirectionalLight(0xfff4e8, 1.35);
    keyLight.position.set(-6.2, 8.4, 10.8);
    keyLight.target = keyLightTarget;
    scene.add(keyLight);

    const fillLight = new THREE.PointLight(0xff8b6a, 0.42, 20, 2);
    fillLight.position.set(0, 2.5, 6.8);
    scene.add(fillLight);

    const cubeSide = 0.2;
    const cubeGeometry = new THREE.BoxGeometry(cubeSide, cubeSide, cubeSide);

    const textureLoader = new THREE.TextureLoader();
    const animatedTextures = [];

    function setAtlasFrame(texture, frame, columns, rows) {
      const column = frame % columns;
      const row = Math.floor(frame / columns);

      texture.repeat.set(1 / columns, 1 / rows);
      texture.offset.set(column / columns, 1 - (row + 1) / rows);
    }

    const cubeMaterials =
      textureDescriptors.length > 0
        ? textureDescriptors.map((descriptor) => {
            const texture = textureLoader.load(descriptor.url);
            texture.colorSpace = THREE.SRGBColorSpace;
            texture.magFilter = THREE.NearestFilter;
            texture.minFilter = THREE.NearestFilter;
            texture.generateMipmaps = false;
            texture.wrapS = THREE.ClampToEdgeWrapping;
            texture.wrapT = THREE.ClampToEdgeWrapping;

            if (descriptor.animation) {
              setAtlasFrame(
                texture,
                descriptor.animation.startFrame,
                descriptor.animation.columns,
                descriptor.animation.rows,
              );
            }

            texture.needsUpdate = true;
            const material = new THREE.MeshStandardMaterial({
              map: texture,
              roughness: 0.52,
              metalness: 0.02,
            });

            if (descriptor.animation && descriptor.animation.frameCount > 1) {
              animatedTextures.push({
                texture,
                columns: descriptor.animation.columns,
                rows: descriptor.animation.rows,
                frameCount: descriptor.animation.frameCount,
                fps: descriptor.animation.fps,
                currentFrame: descriptor.animation.startFrame,
                elapsed: 0,
              });
            }

            return material;
          })
        : [new THREE.MeshStandardMaterial({ color: 0xf2d96b })];

    const balls = [];
    const spawnState = {
      total: 108,
      spawned: 0,
      interval: 1.05,
      timer: 0,
      minX: isBackground ? -3.2 : -2.3,
      maxX: isBackground ? 3.2 : 2.3,
      minZ: isBackground ? -1.2 : -0.5,
      maxZ: isBackground ? 2.2 : 1.3,
      y: isBackground ? 7.4 : 6.1,
      initialYVelocity: -0.15,
    };
    const gravity = -0.1;
    const despawnY = -14;

    function spawnBall() {
      const x = THREE.MathUtils.randFloat(spawnState.minX, spawnState.maxX);
      const z = THREE.MathUtils.randFloat(spawnState.minZ, spawnState.maxZ);
      const y = spawnState.y + (spawnState.spawned % 4) * 0.12;

      const material = cubeMaterials[spawnState.spawned % cubeMaterials.length];

      const root = new THREE.Object3D();
      const cube = new THREE.Mesh(cubeGeometry, material);
      root.add(cube);
      root.position.set(x, y, z);
      scene.add(root);

      const spinDirection = new THREE.Vector3(
        THREE.MathUtils.randFloatSpread(2),
        THREE.MathUtils.randFloatSpread(2),
        THREE.MathUtils.randFloatSpread(2),
      );
      if (spinDirection.lengthSq() < 0.03) {
        spinDirection.set(0.45, 0.72, -0.51);
      }
      spinDirection.normalize();
      const spinSpeed = THREE.MathUtils.randFloat(0.95, 2.6);

      balls.push({
        root,
        velocityY:
          spawnState.initialYVelocity + THREE.MathUtils.randFloat(-0.08, 0.02),
        spin: spinDirection.multiplyScalar(spinSpeed),
      });
      spawnState.spawned += 1;
    }

    const clock = new THREE.Clock();

    let rafId = 0;
    let isDisposed = false;

    if (spawnState.total > 0) {
      spawnBall();
    }

    function animate() {
      const dt = Math.min(clock.getDelta(), 0.05);

      spawnState.timer += dt;
      while (
        spawnState.timer >= spawnState.interval &&
        spawnState.spawned < spawnState.total
      ) {
        spawnBall();
        spawnState.timer -= spawnState.interval;
      }

      for (let i = balls.length - 1; i >= 0; i -= 1) {
        const item = balls[i];
        item.velocityY += gravity * dt;
        item.root.position.y += item.velocityY * dt;
        item.root.rotation.x += item.spin.x * dt;
        item.root.rotation.y += item.spin.y * dt;
        item.root.rotation.z += item.spin.z * dt;

        if (item.root.position.y <= despawnY) {
          scene.remove(item.root);
          balls.splice(i, 1);
        }
      }

      for (let i = 0; i < animatedTextures.length; i += 1) {
        const animatedTexture = animatedTextures[i];
        const frameDuration = 1 / animatedTexture.fps;
        animatedTexture.elapsed += dt;

        if (animatedTexture.elapsed < frameDuration) {
          continue;
        }

        const framesToAdvance = Math.floor(animatedTexture.elapsed / frameDuration);
        animatedTexture.elapsed -= framesToAdvance * frameDuration;
        animatedTexture.currentFrame =
          (animatedTexture.currentFrame + framesToAdvance) %
          animatedTexture.frameCount;

        setAtlasFrame(
          animatedTexture.texture,
          animatedTexture.currentFrame,
          animatedTexture.columns,
          animatedTexture.rows,
        );
      }

      renderer.render(scene, camera);
      rafId = requestAnimationFrame(animate);
    }

    function onResize() {
      const width = hostEl.clientWidth;
      const height = hostEl.clientHeight;

      if (width <= 0 || height <= 0) {
        return;
      }

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }

    function dispose() {
      if (isDisposed) {
        return;
      }
      isDisposed = true;

      cancelAnimationFrame(rafId);
      window.removeEventListener("resize", onResize);
      document.removeEventListener("astro:before-swap", dispose);

      for (let i = 0; i < balls.length; i += 1) {
        scene.remove(balls[i].root);
      }

      cubeGeometry.dispose();
      for (let i = 0; i < cubeMaterials.length; i += 1) {
        cubeMaterials[i].map?.dispose();
        cubeMaterials[i].dispose();
      }

      renderer.dispose();
      hostEl.innerHTML = "";
      hostEl.dataset.initialized = "false";
    }

    window.addEventListener("resize", onResize);
    document.addEventListener("astro:before-swap", dispose);

    animate();
  }
</script>

<style>
  .scene-wrapper {
    display: grid;
    gap: 1rem;
  }

  .scene-header h1 {
    font-family: "PixeloidSans", sans-serif;
    font-size: clamp(1.15rem, 1.1rem + 0.9vw, 1.8rem);
    margin: 0;
    letter-spacing: 0.03em;
  }

  .scene-header p {
    margin: 0.5rem 0 0;
    color: #f8d1ce;
    max-width: 65ch;
    line-height: 1.5;
  }

  .scene-header code {
    color: #ffdcb3;
  }

  .scene-stage {
    position: relative;
    border: 2px solid #f8d1ce55;
    border-radius: 0.8rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 14%, #4c3078 0%, #261243 35%, #0f071f 100%);
  }

  .scene-host {
    width: 100%;
    height: clamp(420px, 72vh, 820px);
  }

  .scene-wrapper--background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: block;
    overflow: hidden;
  }

  .scene-wrapper--background .scene-stage {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    filter: blur(2px) saturate(0.82) brightness(0.8);
    transform: scale(1.08);
    transform-origin: center;
  }

  .scene-wrapper--background .scene-host {
    min-height: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .scene-host {
      height: min(70vh, 560px);
    }
  }
</style>
