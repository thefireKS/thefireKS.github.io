---
type BallTextureAnimationConfig = {
  columns: number;
  rows: number;
  fromFrame: number;
  toFrame: number;
  fps: number;
};

type BallTextureDescriptor = {
  name: string;
  url: string;
  animation: BallTextureAnimationConfig | null;
};

type AtlasSpriteConfig = {
  name: string;
  fromFrame: number;
  toFrame: number;
  fps: number;
};

type AtlasConfig = {
  columns: number;
  rows: number;
  sprites: AtlasSpriteConfig[];
};

interface Props {
  mode?: "default" | "background";
  showHeader?: boolean;
}

const { mode = "default", showHeader = mode !== "background" } = Astro.props;
const isBackground = mode === "background";

const uploadedTextureModules = import.meta.glob(
  "../assets/ball-textures/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);

const uploadedAtlasConfigModules = import.meta.glob(
  "../assets/ball-textures/*.atlas.json",
  { eager: true, import: "default" },
);

function getModuleAssetUrl(moduleValue: unknown) {
  const maybeDefault = (moduleValue as { default?: unknown }).default;

  if (typeof maybeDefault === "string") {
    return maybeDefault;
  }

  if (maybeDefault && typeof maybeDefault === "object" && "src" in maybeDefault) {
    const srcValue = (maybeDefault as { src?: unknown }).src;
    return typeof srcValue === "string" ? srcValue : null;
  }

  return null;
}

function getFileStem(modulePath: string) {
  const normalizedPath = modulePath.replaceAll("\\", "/");
  const fileName = normalizedPath.slice(normalizedPath.lastIndexOf("/") + 1);
  return fileName.replace(/\.[^.]+$/, "");
}

function getAtlasStem(modulePath: string) {
  const normalizedPath = modulePath.replaceAll("\\", "/");
  const fileName = normalizedPath.slice(normalizedPath.lastIndexOf("/") + 1);
  return fileName.replace(/\.atlas\.json$/, "");
}

function toPositiveInteger(value: unknown) {
  if (typeof value !== "number" || !Number.isFinite(value)) {
    return null;
  }

  const normalizedValue = Math.floor(value);
  return normalizedValue > 0 ? normalizedValue : null;
}

function toPositiveNumber(value: unknown) {
  if (typeof value !== "number" || !Number.isFinite(value) || value <= 0) {
    return null;
  }

  return value;
}

function toFrameIndex(value: unknown, lastFrame: number) {
  if (typeof value !== "number" || !Number.isFinite(value)) {
    return null;
  }

  const frame = Math.floor(value);
  return frame >= 0 && frame <= lastFrame ? frame : null;
}

// New-style sheets list every sprite they hold as an inclusive frame range.
function normalizeSpriteList(
  rawSprites: unknown[],
  lastFrame: number,
  sheetFps: number,
): AtlasSpriteConfig[] {
  return rawSprites
    .map((rawSprite, index) => {
      if (!rawSprite || typeof rawSprite !== "object") {
        return null;
      }

      const sprite = rawSprite as Record<string, unknown>;
      const fromFrame = toFrameIndex(sprite.from, lastFrame);

      if (fromFrame === null) {
        return null;
      }

      const toFrame = toFrameIndex(sprite.to, lastFrame) ?? fromFrame;

      if (toFrame < fromFrame) {
        return null;
      }

      const rawName = typeof sprite.name === "string" ? sprite.name.trim() : "";

      return {
        name: rawName === "" ? `sprite-${index}` : rawName,
        fromFrame,
        toFrame,
        fps: toPositiveNumber(sprite.fps) ?? sheetFps,
      };
    })
    .filter((sprite): sprite is AtlasSpriteConfig => sprite !== null);
}

// Older sheets held a single animation described by frameCount/startFrame.
function normalizeLegacySprite(
  config: Record<string, unknown>,
  lastFrame: number,
  sheetFps: number,
): AtlasSpriteConfig[] {
  const frameCount = Math.min(
    toPositiveInteger(config.frameCount) ??
      toPositiveInteger(config.totalFrames) ??
      lastFrame + 1,
    lastFrame + 1,
  );
  const startFrame = Math.min(
    toFrameIndex(config.startFrame, lastFrame) ?? 0,
    frameCount - 1,
  );

  return [
    {
      name: "",
      fromFrame: startFrame,
      toFrame: frameCount - 1,
      fps: sheetFps,
    },
  ];
}

function normalizeAtlasConfig(rawConfig: unknown): AtlasConfig | null {
  if (!rawConfig || typeof rawConfig !== "object") {
    return null;
  }

  const config = rawConfig as Record<string, unknown>;
  const columns = toPositiveInteger(config.columns);
  const rows = toPositiveInteger(config.rows);

  if (!columns || !rows) {
    return null;
  }

  const lastFrame = columns * rows - 1;
  const sheetFps = toPositiveNumber(config.fps) ?? 24;
  const sprites = Array.isArray(config.sprites)
    ? normalizeSpriteList(config.sprites, lastFrame, sheetFps)
    : normalizeLegacySprite(config, lastFrame, sheetFps);

  return sprites.length > 0 ? { columns, rows, sprites } : null;
}

const atlasConfigByTextureName = new Map(
  Object.entries(uploadedAtlasConfigModules)
    .map(([modulePath, rawConfig]) => [
      getAtlasStem(modulePath),
      normalizeAtlasConfig(rawConfig),
    ])
    .filter((entry): entry is [string, AtlasConfig] => entry[1] !== null),
);

// One sheet expands into one descriptor per sprite; they all share the same
// url, so the browser fetches the image once no matter how many sprites use it.
const ballTextureDescriptors: BallTextureDescriptor[] = Object.entries(
  uploadedTextureModules,
)
  .map(([modulePath, moduleValue]) => ({
    stem: getFileStem(modulePath),
    url: getModuleAssetUrl(moduleValue),
  }))
  .filter((sheet): sheet is { stem: string; url: string } => sheet.url !== null)
  .sort((left, right) => left.stem.localeCompare(right.stem))
  .flatMap(({ stem, url }): BallTextureDescriptor[] => {
    const atlas = atlasConfigByTextureName.get(stem);

    if (!atlas) {
      return [{ name: stem, url, animation: null }];
    }

    return atlas.sprites.map((sprite) => ({
      name: sprite.name === "" ? stem : `${stem}/${sprite.name}`,
      url,
      animation: {
        columns: atlas.columns,
        rows: atlas.rows,
        fromFrame: sprite.fromFrame,
        toFrame: sprite.toFrame,
        fps: sprite.fps,
      },
    }));
  });
---

<section
  class:list={["scene-wrapper", isBackground && "scene-wrapper--background"]}
  aria-hidden={isBackground ? "true" : undefined}
>
  {
    showHeader && (
      <header class="scene-header">
        <h1>Emoticons Waterfall</h1>
        <p>
          A 2D canvas waterfall of sprites cut straight out of the sheets in
          <code>src/assets/ball-textures</code>. Add an optional
          <code>&lt;texture-name&gt;.atlas.json</code> next to a sheet to slice
          it into named sprites and animate them.
        </p>
      </header>
    )
  }

  <div class="scene-stage">
    <div
      class="scene-host"
      data-emoticons-scene-host
      data-scene-mode={mode}
      data-textures={JSON.stringify(ballTextureDescriptors)}
    ></div>
  </div>
</section>

<script type="module">
  const hosts = document.querySelectorAll("[data-emoticons-scene-host]");
  for (const host of hosts) {
    if (host.dataset.initialized === "true") {
      continue;
    }

    host.dataset.initialized = "true";
    initScene(host);
  }

  function randomRange(min, max) {
    return min + Math.random() * (max - min);
  }

  function lerp(min, max, t) {
    return min + (max - min) * t;
  }

  function buildShuffledIndices(size) {
    const indices = Array.from({ length: size }, (_, index) => index);

    for (let i = indices.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      const swap = indices[i];
      indices[i] = indices[j];
      indices[j] = swap;
    }

    return indices;
  }

  function initScene(hostEl) {
    const textureDescriptors = JSON.parse(hostEl.dataset.textures || "[]");

    if (textureDescriptors.length === 0) {
      return;
    }

    const isBackground = hostEl.dataset.sceneMode === "background";

    const canvas = document.createElement("canvas");
    const ctx = canvas.getContext("2d");
    hostEl.append(canvas);

    // Every sprite cut from the same file reuses one Image, so the browser
    // fetches and decodes the sheet once no matter how many sprites use it.
    const sheetImages = new Map();

    function loadSheetImage(url) {
      let image = sheetImages.get(url);

      if (!image) {
        image = new Image();
        image.src = url;
        sheetImages.set(url, image);
      }

      return image;
    }

    // Frame state lives per sprite rather than per falling particle: every
    // particle showing the same emote stays in sync, and we tick one timer per
    // sprite instead of one per particle.
    const sprites = textureDescriptors.map((descriptor) => {
      const animation = descriptor.animation;

      return {
        image: loadSheetImage(descriptor.url),
        columns: animation ? animation.columns : 1,
        rows: animation ? animation.rows : 1,
        fromFrame: animation ? animation.fromFrame : 0,
        frameCount: animation ? animation.toFrame - animation.fromFrame + 1 : 1,
        fps: animation ? animation.fps : 0,
        currentFrame: 0,
        elapsed: 0,
      };
    });

    const minSize = isBackground ? 18 : 26;
    const maxSize = isBackground ? 52 : 78;
    const minSpeed = isBackground ? 26 : 34;
    const maxSpeed = isBackground ? 82 : 104;

    const particles = [];
    let width = 0;
    let height = 0;

    // Spawns walk a shuffled set of columns so the waterfall keeps an even
    // spread instead of clumping wherever Math.random happens to land.
    let columnOrder = [];
    let columnCursor = 0;
    let columnCount = 1;

    function nextSpawnX(size) {
      if (columnOrder.length === 0 || columnCursor >= columnOrder.length) {
        columnOrder = buildShuffledIndices(columnCount);
        columnCursor = 0;
      }

      const cell = columnOrder[columnCursor];
      columnCursor += 1;

      const cellWidth = width / columnCount;
      const jitter = randomRange(-cellWidth * 0.3, cellWidth * 0.3);
      const x = (cell + 0.5) * cellWidth + jitter - size / 2;

      return Math.min(Math.max(x, -size * 0.25), width - size * 0.75);
    }

    function resetParticle(particle, initialY) {
      // One knob drives size, speed and opacity together, so the small sprites
      // read as further away rather than merely smaller.
      const depth = Math.random();

      particle.sprite = sprites[Math.floor(Math.random() * sprites.length)];
      particle.size = Math.round(lerp(minSize, maxSize, depth));
      particle.speed = lerp(minSpeed, maxSpeed, depth);
      particle.alpha = lerp(0.42, 1, depth);
      particle.x = nextSpawnX(particle.size);
      particle.y = initialY;
      particle.sway = randomRange(2, 11);
      particle.swaySpeed = randomRange(0.35, 0.95);
      particle.swayPhase = Math.random() * Math.PI * 2;
    }

    function syncParticleCount() {
      const density = isBackground ? 6200 : 9000;
      const target = Math.min(
        Math.max(Math.round((width * height) / density), 24),
        220,
      );

      while (particles.length > target) {
        particles.pop();
      }

      while (particles.length < target) {
        const particle = {};
        resetParticle(particle, randomRange(-height * 0.2, height));
        particles.push(particle);
      }
    }

    function onResize() {
      const nextWidth = hostEl.clientWidth;
      const nextHeight = hostEl.clientHeight;

      if (nextWidth <= 0 || nextHeight <= 0) {
        return;
      }

      width = nextWidth;
      height = nextHeight;
      columnCount = Math.max(Math.round(width / 90), 4);
      columnOrder = [];
      columnCursor = 0;

      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      // Both of these are wiped whenever the backing store is resized.
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.imageSmoothingEnabled = false;

      syncParticleCount();
    }

    function advanceSprites(dt) {
      for (let i = 0; i < sprites.length; i += 1) {
        const sprite = sprites[i];

        if (sprite.frameCount <= 1) {
          continue;
        }

        const frameDuration = 1 / sprite.fps;
        sprite.elapsed += dt;

        if (sprite.elapsed < frameDuration) {
          continue;
        }

        const framesToAdvance = Math.floor(sprite.elapsed / frameDuration);
        sprite.elapsed -= framesToAdvance * frameDuration;
        sprite.currentFrame =
          (sprite.currentFrame + framesToAdvance) % sprite.frameCount;
      }
    }

    function drawParticle(particle, time) {
      const sprite = particle.sprite;
      const image = sprite.image;

      if (!image.complete || image.naturalWidth === 0) {
        return;
      }

      const tileWidth = image.naturalWidth / sprite.columns;
      const tileHeight = image.naturalHeight / sprite.rows;
      const frame = sprite.fromFrame + sprite.currentFrame;
      const sourceX = (frame % sprite.columns) * tileWidth;
      const sourceY = Math.floor(frame / sprite.columns) * tileHeight;
      const swayX =
        Math.sin(time * particle.swaySpeed + particle.swayPhase) * particle.sway;

      ctx.globalAlpha = particle.alpha;
      ctx.drawImage(
        image,
        sourceX,
        sourceY,
        tileWidth,
        tileHeight,
        Math.round(particle.x + swayX),
        Math.round(particle.y),
        particle.size,
        particle.size,
      );
    }

    let rafId = 0;
    let lastTime = 0;
    let isDisposed = false;

    function animate(now) {
      const dt = lastTime === 0 ? 0 : Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      advanceSprites(dt);
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i += 1) {
        const particle = particles[i];
        particle.y += particle.speed * dt;

        if (particle.y > height + particle.size) {
          resetParticle(particle, -particle.size);
        }

        drawParticle(particle, now / 1000);
      }

      ctx.globalAlpha = 1;
      rafId = requestAnimationFrame(animate);
    }

    function dispose() {
      if (isDisposed) {
        return;
      }

      isDisposed = true;
      cancelAnimationFrame(rafId);
      window.removeEventListener("resize", onResize);
      document.removeEventListener("astro:before-swap", dispose);

      particles.length = 0;
      sheetImages.clear();
      hostEl.innerHTML = "";
      hostEl.dataset.initialized = "false";
    }

    window.addEventListener("resize", onResize);
    document.addEventListener("astro:before-swap", dispose);

    onResize();
    rafId = requestAnimationFrame(animate);
  }
</script>

<style>
  .scene-wrapper {
    display: grid;
    gap: 1rem;
  }

  .scene-header h1 {
    font-family: "PixeloidSans", sans-serif;
    font-size: clamp(1.15rem, 1.1rem + 0.9vw, 1.8rem);
    margin: 0;
    letter-spacing: 0.03em;
  }

  .scene-header p {
    margin: 0.5rem 0 0;
    color: #f8d1ce;
    max-width: 65ch;
    line-height: 1.5;
  }

  .scene-header code {
    color: #ffdcb3;
  }

  .scene-stage {
    position: relative;
    border: 2px solid #f8d1ce55;
    border-radius: 0.8rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 14%, #4c3078 0%, #261243 35%, #0f071f 100%);
  }

  .scene-host {
    width: 100%;
    height: clamp(420px, 72vh, 820px);
  }

  .scene-host canvas {
    display: block;
  }

  .scene-wrapper--background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: block;
    overflow: hidden;
  }

  .scene-wrapper--background .scene-stage {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    /* Flat backdrop the 3D renderer used to paint as its clear colour; the
       canvas is transparent now, so it has to come from CSS. */
    background: #322a2a;
    filter: blur(2px) saturate(0.82) brightness(0.9);
    transform: scale(1.08);
    transform-origin: center;
  }

  .scene-wrapper--background .scene-host {
    min-height: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .scene-host {
      height: min(70vh, 560px);
    }
  }
</style>
