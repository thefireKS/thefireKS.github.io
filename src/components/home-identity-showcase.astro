---
import { Image } from "astro:assets";
import FireKSProfilePicture from "$assets/fireks_picture.png";
---

<div class="identity-stage" data-identity-stage style="--identity-focus: 35%;">
  <div class="identity-dialogue-panel">
    <!-- <p class="identity-kicker">Upper text</p> -->
    <h3>Welcome to the halfwaypixel space</h3>
    <p class="identity-lead">
      I make games, art, prototypes, and all the strange little things in between.
      <strong>Halfwaypixel</strong> is the studio label around that work, not a
      separate person fighting for attention in the header.
    </p>

    <div class="identity-dialogue">
      <article class="speech-bubble speech-bubble-person">
        <span class="speech-author">thefireks</span>
        <p>
          When you land here, you are meeting the person first: the one drawing,
          designing, prototyping, shipping, and answering messages.
        </p>
      </article>

      <article class="speech-bubble speech-bubble-studio">
        <span class="speech-author">halfwaypixel</span>
        <p>
          Think of me as the studio banner above those projects. I am how the work
          gets framed, packaged, and published.
        </p>
      </article>

      <article class="speech-bubble speech-bubble-person">
        <span class="speech-author">thefireks</span>
        <p>
          SampleText
          Like that
        </p>
      </article>
    </div>
  </div>

  <aside class="identity-portrait-panel">
    <div class="identity-portrait-frame">
      <Image
        src={FireKSProfilePicture}
        alt="Portrait of thefireks"
        class="identity-portrait-image"
      />
    </div>

    <div class="identity-portrait-copy">
      <p class="identity-portrait-kicker">One creator, one studio</p>
      <h4>thefireks leads Halfwaypixel</h4>
      <p>
        So the short version for the base page is simple: hi, I am thefireks, and
        Halfwaypixel is the studio identity behind the games, art drops, and odd
        experiments you see here.
      </p>
    </div>
  </aside>
</div>

<script>
  const identityStates = [
    {
      max: 25,
      label: "Mostly the person",
      description:
        "This side keeps the intro very personal: thefireks is the artist, developer, and voice behind the site.",
    },
    {
      max: 70,
      label: "Person first, studio second",
      description:
        "This is the sweet spot: you meet thefireks first, while Halfwaypixel works as the studio wrapper around the projects.",
    },
    {
      max: 100,
      label: "Studio-forward framing",
      description:
        "Push further right and the studio identity takes more space, which makes sense once the work becomes a published release or collaboration.",
    },
  ];

  const initializeIdentityStages = () => {
    const stages = document.querySelectorAll("[data-identity-stage]");

    stages.forEach((stage) => {
      if (!(stage instanceof HTMLElement) || stage.dataset.ready === "true") {
        return;
      }

      const slider = stage.querySelector("[data-identity-slider]");
      const label = stage.querySelector("[data-identity-label]");
      const description = stage.querySelector("[data-identity-description]");
      const thumb = stage.querySelector("[data-identity-thumb]");

      if (
        !(slider instanceof HTMLInputElement) ||
        !(label instanceof HTMLElement) ||
        !(description instanceof HTMLElement) ||
        !(thumb instanceof HTMLElement)
      ) {
        return;
      }

      const updateStage = () => {
        const value = Number(slider.value);
        const activeState =
          identityStates.find((state) => value <= state.max) ?? identityStates.at(-1);

        if (!activeState) {
          return;
        }

        stage.style.setProperty("--identity-focus", `${value}%`);
        label.textContent = activeState.label;
        description.textContent = activeState.description;
        thumb.style.left = `${value}%`;
      };

      stage.dataset.ready = "true";
      slider.addEventListener("input", updateStage);
      updateStage();
    });
  };

  initializeIdentityStages();
  document.addEventListener("astro:page-load", initializeIdentityStages);
</script>
