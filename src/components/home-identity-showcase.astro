---
import { Image } from "astro:assets";
import FireKSProfilePicture from "$assets/fireks_picture.png";
---

<div class="identity-stage" data-identity-stage style="--identity-focus: 35%;">
  <div class="identity-dialogue-panel">
    <!-- <p class="identity-kicker">Upper text</p> -->
    <h3>Welcome to the halfwaypixel space</h3>
    <!-- 
    <p class="identity-lead">
      I make games, art, prototypes, and all the strange little things in between.
      <strong>Halfwaypixel</strong> is the studio label around that work, not a
      separate person fighting for attention in the header.
    </p>
    -->
    <div class="identity-dialogue">
      <article class="speech-bubble speech-bubble-person">
        <span class="speech-author">fireks</span>
        <p>
          Yo, can we show something cool here? Like, it's the main page guys!
        </p>
      </article>
      <article class="speech-bubble speech-bubble-studio">
        <span class="speech-author">halfwaypixel</span>
        <p>
          Sure.
        </p>
        <video
          class="identity-inline-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src="/videos/temp-identity-banner.webm" type="video/webm" />
          <source src="/videos/temp-identity-banner.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </article>
      <article class="speech-bubble speech-bubble-person">
        <span class="speech-author">fireks</span>
        <p>
          Heeeell yeaahhh!!!1
        </p>
      </article>
    </div>
  </div>

  <aside class="identity-portrait-panel">
    <div class="identity-portrait-frame">
      <Image
        src={FireKSProfilePicture}
        alt="Portrait of thefireks"
        class="identity-portrait-image"
      />
    </div>

    <div class="identity-portrait-copy">
      <p class="identity-portrait-kicker">mr. i-do-everything</p>
      <h4>halfwaypixel studio blog!</h4>
      <p>
        On this website, i, fireKS, post everything we do at halfwaypixel studio: all the games,
        demos, art, and other stuff! Also, don't forget to join our discord or follow other socials :D
      </p>
      <div class="identity-contact">
        <p class="identity-contact-title">Contact with the fireKS</p>
        <div class="identity-contact-links">
          <a
            href="https://t.me/thefireKS"
            target="_blank"
            rel="noopener noreferrer"
            class="identity-contact-link identity-contact-link-telegram"
          >
            Telegram
          </a>
          <a
            href="mailto:halfwaypixel@gmail.com"
            class="identity-contact-link identity-contact-link-email"
          >
            Email
          </a>
        </div>
      </div>
    </div>
  </aside>
</div>