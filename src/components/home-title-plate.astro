---
/*
 * The title screen's title card.
 *
 * The counts are read from the real collections rather than written by hand, so
 * the plate cannot claim more than the site actually holds — and it grows on
 * its own every time something ships.
 *
 * The banner loop plays behind everything, under a veil dark enough to keep the
 * wordmark readable no matter what the footage is doing. The plate never gets
 * wider than 1236px, and `cover` crops hard in both directions — roughly the
 * middle half vertically on desktop and the middle half horizontally on a
 * phone — so the footage has to keep its subject centred.
 */
interface Props {
  gameCount: number;
  artworkCount: number;
  chapterCount: number;
}

/*
 * Encoded from the 1920x1080 showreel master down to 1280x720 — the plate
 * never renders wider than 1236px, so anything above that is bytes nobody
 * sees. VP9 first, H.264 for the browsers that will not take it. The poster is
 * frame one, so the plate does not flash black before the loop arrives.
 *
 * To replace the loop, re-encode the new master with:
 *   ffmpeg -i master.mp4 -vf scale=1280:720:flags=lanczos -c:v libvpx-vp9 \
 *     -crf 40 -b:v 0 -row-mt 1 -an showreel.webm
 *   ffmpeg -i master.mp4 -vf scale=1280:720:flags=lanczos -c:v libx264 \
 *     -crf 28 -preset slow -pix_fmt yuv420p -movflags +faststart -an showreel.mp4
 *   ffmpeg -i master.mp4 -frames:v 1 -vf scale=1280:720 -q:v 4 showreel-poster.jpg
 */
const bannerSources = [
  { src: "/videos/showreel.webm", type: "video/webm" },
  { src: "/videos/showreel.mp4", type: "video/mp4" },
];

const bannerPoster = "/videos/showreel-poster.jpg";

const { gameCount, artworkCount, chapterCount } = Astro.props;

const stats = [
  { value: gameCount, label: gameCount === 1 ? "game" : "games" },
  { value: artworkCount, label: artworkCount === 1 ? "artwork" : "artworks" },
  { value: chapterCount, label: chapterCount === 1 ? "chapter" : "chapters" },
];
---

<section class="plate">
  <video
    class="plate-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={bannerPoster}
    aria-hidden="true"
    tabindex="-1"
  >
    {
      bannerSources.map((source) => (
        <source src={source.src} type={source.type} />
      ))
    }
  </video>

  <div class="plate-veil" aria-hidden="true"></div>
  <div class="plate-scanlines" aria-hidden="true"></div>

  <span class="plate-corner plate-corner-tl" aria-hidden="true"></span>
  <span class="plate-corner plate-corner-tr" aria-hidden="true"></span>
  <span class="plate-corner plate-corner-bl" aria-hidden="true"></span>
  <span class="plate-corner plate-corner-br" aria-hidden="true"></span>

  <div class="plate-inner">
    <p class="plate-eyebrow">doing stuff you never seen before</p>

    <h1 class="plate-wordmark">
      halfwaypixel<span class="plate-caret" aria-hidden="true"></span>
    </h1>

    <p class="plate-tagline">
      There's everything we have - games, art, comics... maybe something else?
    </p>

    <ul class="plate-stats">
      {
        stats.map((stat) => (
          <li class="plate-stat">
            <span class="plate-stat-value">{stat.value}</span>
            <span class="plate-stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .plate {
    position: relative;
    overflow: hidden;
    border: 2px solid #ffffff1f;
    border-radius: 0.15rem;
    background:
      radial-gradient(ellipse 80% 120% at 50% -20%, #ce203f33, transparent 70%),
      radial-gradient(ellipse 60% 90% at 88% 110%, #eb820a26, transparent 70%),
      linear-gradient(180deg, #1b1522 0%, #100c15 100%);
    box-shadow: inset 0 0 0 2px #00000040;
  }

  /*
   * Layers, bottom to top: banner loop, veil, scanlines, corner brackets, copy.
   * The plate keeps its own gradient underneath as the backdrop for whenever
   * the video is missing, still loading, or switched off for reduced motion.
   */
  .plate-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.06) contrast(1.03);
  }

  /*
   * Dark enough for the copy, light enough that the showreel is still worth
   * playing. The copy carries its own shadows so this does not have to do all
   * the work — a veil heavy enough to guarantee contrast on its own would hide
   * the footage completely.
   */
  .plate-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 76% 94% at 50% 50%, #06040a40, #06040ac4 78%),
      linear-gradient(180deg, #100c1599 0%, #100c1526 46%, #100c15a6 100%);
  }

  /* The CRT the rest of the page is pretending to be displayed on. */
  .plate-scanlines {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      #ffffff0a 0 1px,
      transparent 1px 3px
    );
  }

  /* Corner brackets, the way a game UI frames its title. */
  .plate-corner {
    position: absolute;
    z-index: 3;
    width: 14px;
    height: 14px;
    border: 3px solid #eb820a;
    pointer-events: none;
  }

  .plate-corner-tl {
    top: 10px;
    left: 10px;
    border-right: none;
    border-bottom: none;
  }

  .plate-corner-tr {
    top: 10px;
    right: 10px;
    border-bottom: none;
    border-left: none;
  }

  .plate-corner-bl {
    bottom: 10px;
    left: 10px;
    border-top: none;
    border-right: none;
  }

  .plate-corner-br {
    bottom: 10px;
    right: 10px;
    border-top: none;
    border-left: none;
  }

  .plate-inner {
    position: relative;
    z-index: 4;
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    padding: clamp(1.6rem, 0.8rem + 4vw, 2.9rem) 1.75rem;
    text-align: center;
  }

  .plate-eyebrow {
    margin: 0;
    color: #ffffffa6;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    text-shadow: 0 2px 6px #000000d9;
  }

  .plate-wordmark {
    display: flex;
    align-items: center;
    gap: 0.12em;
    margin: 0;
    color: #fff3ec;
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 1.1rem + 5.4vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    text-shadow:
      4px 4px 0 #4a0d1b,
      0 0 28px #ce203f4d;
  }

  /* The blinking block cursor of a machine waiting for you to pick something. */
  .plate-caret {
    display: inline-block;
    width: 0.14em;
    height: 0.82em;
    background: #eb820a;
    animation: plate-blink 1.1s steps(1, end) infinite;
  }

  @keyframes plate-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  .plate-tagline {
    max-width: 46ch;
    margin: 0;
    color: #f7ebe7;
    font-size: 0.98rem;
    line-height: 1.65;
    text-shadow:
      0 1px 3px #000000e6,
      0 2px 12px #000000b3;
  }

  .plate-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .plate-stat {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid #ffffff2e;
    border-radius: 0.15rem;
    background: #000000a6;
    backdrop-filter: blur(3px);
  }

  .plate-stat-value {
    color: #ffb15e;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1;
  }

  .plate-stat-label {
    color: #ffffff9e;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .plate-caret {
      animation: none;
    }

    /* A looping banner is motion too; fall back to the plate's own gradient. */
    .plate-video {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .plate-corner {
      width: 10px;
      height: 10px;
      border-width: 2px;
    }

    .plate-inner {
      padding-inline: 1.1rem;
    }
  }
</style>
