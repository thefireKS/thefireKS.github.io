---
import { Icon } from "astro-icon/components";
import type { ComicChapterEntry } from "$api/comics";
import { formatComicDate, getChapterHref } from "$api/comics";

interface Props {
  chapter: ComicChapterEntry;
  isLatest?: boolean;
}

const { chapter, isLatest = false } = Astro.props;

const pageCountLabel = chapter.data.pages.length === 1 ? "page" : "pages";
const chapterLabel = `Chapter ${chapter.data.chapterNumber}`;
const summary =
  chapter.data.summary?.trim() ??
  "Add release notes, a short teaser, or translation credits here.";
---

<a
  href={getChapterHref(chapter)}
  class="group block rounded-2xl border-2 border-highlight bg-surface-hover p-4 transition-transform duration-300 hover:-translate-y-1"
>
  <div class="flex items-start justify-between gap-3">
    <div class="space-y-1">
      <p class="text-xs uppercase tracking-[0.2em] text-white/60">{chapterLabel}</p>
      <h3 class="text-lg font-heading text-brand-secondary">{chapter.data.title}</h3>
    </div>

    {
      isLatest ? (
        <span class="rounded-full bg-brand px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-black">
          Latest
        </span>
      ) : null
    }
  </div>

  <p class="mt-3 text-sm leading-relaxed text-white/80">{summary}</p>

  <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-white/70">
    <span class="flex items-center gap-2">
      <Icon name="pixelarticons:image" class="text-base text-brand" />
      {chapter.data.pages.length} {pageCountLabel}
    </span>
    <span class="flex items-center gap-2">
      <Icon name="pixelarticons:calendar" class="text-base text-brand" />
      {formatComicDate(chapter.data.releaseDate)}
    </span>
    <span class="ml-auto flex items-center gap-2 font-heading text-brand-secondary">
      Read chapter
      <Icon
        name="pixelarticons:arrow-right"
        class="text-base transition-transform group-hover:translate-x-1"
      />
    </span>
  </div>
</a>
