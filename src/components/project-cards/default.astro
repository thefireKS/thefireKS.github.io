---
import type { Project, ProjectPlatform } from "$api/projects";
import { formatProjectDate } from "$api/projects";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const platformLabels: Record<ProjectPlatform, string> = {
  android: "Android",
  browser: "Browser",
  linux: "Linux",
  macos: "macOS",
  windows: "Windows",
};

const platformIcons: Partial<Record<ProjectPlatform, string>> = {
  android: "material-symbols:android",
  linux: "icomoon-free:tux",
  macos: "ic:baseline-apple",
  windows: "material-symbols:window-sharp",
};

const variant = project.card.variant ?? "default";
const accent = project.card.accent ?? "var(--brand-color-secondary)";
const accentSecondary = project.card.accentSecondary ?? "var(--brand-color)";
const imagePosition = project.card.imagePosition ?? "center";
const badge = project.card.badge ?? project.sourceLabel;
const customClassName = project.card.className ?? "";
const cardClass = [
  "project-card",
  `project-card-${variant}`,
  customClassName,
  "group",
]
  .filter(Boolean)
  .join(" ");

const cardStyle = [
  `--project-card-accent: ${accent}`,
  `--project-card-accent-secondary: ${accentSecondary}`,
  `--project-card-image-position: ${imagePosition}`,
].join("; ");
---

<a
  href={project.url}
  class={cardClass}
  data-project-key={project.key}
  style={cardStyle}
>
  <div class="project-card-media">
    {
      project.coverUrl ? (
        <Image
          src={project.coverUrl}
          alt={project.title}
          width={1280}
          height={320}
          class="project-card-image"
        />
      ) : (
        <div class="project-card-placeholder" aria-hidden="true" />
      )
    }
  </div>

  <div class="project-card-body">
    <div class="project-card-header">
      <div class="project-card-title-group">
        <p class="project-card-eyebrow">{badge}</p>
        <h4 class="project-card-title">{project.title}</h4>
      </div>
      {
        project.publishedAt ? (
          <time
            datetime={project.publishedAt.toISOString()}
            class="project-card-date"
          >
            {formatProjectDate(project.publishedAt)}
          </time>
        ) : null
      }
    </div>

    <div class="project-card-meta">
      {
        project.platforms.map((platform) => {
          const icon = platformIcons[platform];

          return icon ? (
            <Icon name={icon} title={platformLabels[platform]} />
          ) : (
            <span class="project-card-pill">{platformLabels[platform]}</span>
          );
        })
      }
    </div>

    {
      project.description ? (
        <p class="project-card-copy">{project.description}</p>
      ) : null
    }
  </div>
</a>

<style>
  .project-card {
    display: grid;
    overflow: hidden;
    border: 2px solid
      color-mix(in srgb, var(--project-card-accent) 70%, #ffffff20);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--project-card-accent) 16%, transparent),
        transparent 42%
      ),
      var(--surface-hover);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .project-card:hover {
    border-color: var(--project-card-accent);
    transform: translateY(-0.25rem);
  }

  .project-card-media {
    min-height: 12rem;
    overflow: hidden;
    background:
      radial-gradient(
        circle at top left,
        color-mix(
          in srgb,
          var(--project-card-accent-secondary) 30%,
          transparent
        ),
        transparent 44%
      ),
      var(--surface-color);
  }

  .project-card-image,
  .project-card-placeholder {
    width: 100%;
    height: 100%;
    min-height: 12rem;
  }

  .project-card-image {
    display: block;
    object-fit: cover;
    object-position: var(--project-card-image-position);
    transition: transform 240ms ease;
    will-change: transform;
  }

  .project-card:hover .project-card-image {
    transform: scale(1.04);
  }

  .project-card-placeholder {
    background: linear-gradient(
      135deg,
      var(--project-card-accent),
      var(--project-card-accent-secondary)
    );
  }

  .project-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
    /* per-project backdrop; see the pattern block near the bottom */
    background-image: var(--project-card-pattern, none);
  }

  .project-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card-title-group {
    display: grid;
    gap: 0.25rem;
  }

  .project-card-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--project-card-accent) 84%, white);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .project-card-title {
    margin: 0;
    color: var(--project-card-accent);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .project-card-date,
  .project-card-pill {
    flex-shrink: 0;
    border-radius: 0.375rem;
    background: var(--surface-color);
    padding: 0.45rem 0.55rem;
    color: color-mix(in srgb, var(--project-card-accent-secondary) 80%, white);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
  }

  .project-card-copy {
    margin: 0;
    line-height: 1.65;
  }

  .project-card-feature {
    border-color: var(--project-card-accent);
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--project-card-accent) 24%, transparent),
        transparent 50%
      ),
      linear-gradient(
        170deg,
        color-mix(
          in srgb,
          var(--project-card-accent-secondary) 16%,
          transparent
        ),
        transparent 72%
      ),
      var(--surface-hover);
  }

  .project-card-quiet {
    border-color: color-mix(
      in srgb,
      var(--project-card-accent) 36%,
      var(--highlight)
    );
  }

  /*
   * One backdrop per project. These stay low-contrast on purpose — they are
   * there to give each card a texture of its own, not to compete with the
   * bespoke renderers or hurt the copy.
   */

  /* rigging rope, laid on the diagonal */
  .project-card-sailorknot {
    --project-card-pattern: repeating-linear-gradient(
      45deg,
      #f2c14e1c 0 5px,
      transparent 5px 13px
    );
  }

  /* washed-out starfield, matching the grayscale build */
  .project-card-spacivery-legacy {
    --project-card-pattern:
      radial-gradient(#ffffff26 1px, transparent 1.5px) 0 0 / 24px 24px,
      radial-gradient(#ffffff14 1px, transparent 1.5px) 12px 9px / 31px 31px;
  }

  /* the tablecloth the tea gets served on */
  .project-card-grandmother {
    --project-card-pattern:
      repeating-linear-gradient(90deg, #f0a84814 0 10px, transparent 10px 20px),
      repeating-linear-gradient(0deg, #8fbf6a12 0 10px, transparent 10px 20px);
  }

  /* long ocean swell */
  .project-card-ships-world {
    --project-card-pattern: repeating-linear-gradient(
      0deg,
      #5cc8ff1a 0 2px,
      transparent 2px 11px
    );
  }

  /* the caravan road, dashed across the desert */
  .project-card-corovans {
    --project-card-pattern:
      repeating-linear-gradient(-12deg, #e8b04b1c 0 3px, transparent 3px 26px),
      repeating-linear-gradient(
        -12deg,
        #7ab64814 13px 16px,
        transparent 16px 39px
      );
  }

  /* the tactical grid, in isometric */
  .project-card-mexa {
    --project-card-pattern:
      repeating-linear-gradient(30deg, #8fd14f1e 0 1px, transparent 1px 16px),
      repeating-linear-gradient(-30deg, #7fa8d91e 0 1px, transparent 1px 16px);
  }

  /* bubbles coming up past the raft */
  .project-card-floating-fuzzies {
    --project-card-pattern:
      radial-gradient(circle, #79d2ff2b 3px, transparent 3.5px) 0 0 / 27px 27px,
      radial-gradient(circle, #b8f7d424 1.5px, transparent 2px) 14px 13px / 27px
        27px;
  }

  .project-card-floating-fuzzies .project-card-media {
    background:
      radial-gradient(circle at 20% 20%, #ffffff54, transparent 18%),
      radial-gradient(circle at 80% 70%, #b8f7d452, transparent 24%), #12202a;
  }

  /* deep space, denser than its grayscale sequel */
  .project-card-spacivery {
    --project-card-pattern:
      radial-gradient(#b98cff36 1px, transparent 1.6px) 0 0 / 19px 19px,
      radial-gradient(#ffd16628 1px, transparent 1.6px) 9px 11px / 26px 26px;
  }

  /* big bouncy polka dots */
  .project-card-shoot-em-bounce {
    --project-card-pattern:
      radial-gradient(circle, #ff6b5c26 8px, transparent 9px) 0 0 / 38px 38px,
      radial-gradient(circle, #ffc23326 5px, transparent 6px) 19px 19px / 38px
        38px;
  }

  @media (min-width: 768px) {
    .project-card {
      grid-template-columns: minmax(12rem, 18rem) 1fr;
    }

    .project-card-media,
    .project-card-image,
    .project-card-placeholder {
      min-height: 100%;
    }
  }
</style>
