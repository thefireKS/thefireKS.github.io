---
/*
 * Dispatcher. Picks the bespoke renderer registered for this project, or
 * falls back to the shared default card.
 *
 * See PROJECT_CARD_CUSTOMIZATION.md for how to add either kind.
 */
import type { Project } from "$api/projects";
import DefaultCard from "./project-cards/default.astro";
import {
  projectCardRenderers,
  type ProjectCardRendererKey,
} from "./project-cards/registry";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const Renderer =
  projectCardRenderers[project.key as ProjectCardRendererKey] ?? DefaultCard;
---

<Renderer project={project} />
