---
import type { Project, ProjectPlatform } from "$api/projects";
import { formatProjectDate } from "$api/projects";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const platformLabels: Record<ProjectPlatform, string> = {
  android: "Android",
  browser: "Browser",
  linux: "Linux",
  macos: "macOS",
  windows: "Windows",
};

const platformIcons: Partial<Record<ProjectPlatform, string>> = {
  android: "material-symbols:android",
  linux: "icomoon-free:tux",
  macos: "ic:baseline-apple",
  windows: "material-symbols:window-sharp",
};

const variant = project.card.variant ?? "default";
const accent = project.card.accent ?? "var(--brand-color-secondary)";
const accentSecondary = project.card.accentSecondary ?? "var(--brand-color)";
const imagePosition = project.card.imagePosition ?? "center";
const badge = project.card.badge ?? project.sourceLabel;
const customClassName = project.card.className ?? "";
const cardClass = [
  "project-card",
  `project-card-${variant}`,
  customClassName,
  "group",
]
  .filter(Boolean)
  .join(" ");

const cardStyle = [
  `--project-card-accent: ${accent}`,
  `--project-card-accent-secondary: ${accentSecondary}`,
  `--project-card-image-position: ${imagePosition}`,
].join("; ");
---

<a
  href={project.url}
  class={cardClass}
  data-project-key={project.key}
  style={cardStyle}
>
  <div class="project-card-media">
    {
      project.coverUrl ? (
        <Image
          src={project.coverUrl}
          alt={project.title}
          width={1280}
          height={320}
          class="project-card-image"
        />
      ) : (
        <div class="project-card-placeholder" aria-hidden="true" />
      )
    }
  </div>

  <div class="project-card-body">
    <div class="project-card-header">
      <div class="project-card-title-group">
        <p class="project-card-eyebrow">{badge}</p>
        <h4 class="project-card-title">{project.title}</h4>
      </div>
      {
        project.publishedAt ? (
          <time
            datetime={project.publishedAt.toISOString()}
            class="project-card-date"
          >
            {formatProjectDate(project.publishedAt)}
          </time>
        ) : null
      }
    </div>

    <div class="project-card-meta">
      {
        project.platforms.map((platform) => {
          const icon = platformIcons[platform];

          return icon ? (
            <Icon name={icon} title={platformLabels[platform]} />
          ) : (
            <span class="project-card-pill">{platformLabels[platform]}</span>
          );
        })
      }
    </div>

    {
      project.description ? (
        <p class="project-card-copy">{project.description}</p>
      ) : null
    }
  </div>
</a>

<style>
  .project-card {
    display: grid;
    min-height: 100%;
    overflow: hidden;
    border: 2px solid
      color-mix(in srgb, var(--project-card-accent) 70%, #ffffff20);
    border-radius: 0.5rem;
    color: inherit;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--project-card-accent) 16%, transparent),
        transparent 42%
      ),
      var(--surface-hover);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .project-card:hover {
    border-color: var(--project-card-accent);
    transform: translateY(-0.25rem);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--project-card-accent);
    outline-offset: 4px;
  }

  .project-card-media {
    min-height: 12rem;
    overflow: hidden;
    background:
      radial-gradient(
        circle at top left,
        color-mix(
          in srgb,
          var(--project-card-accent-secondary) 30%,
          transparent
        ),
        transparent 44%
      ),
      var(--surface-color);
  }

  .project-card-image,
  .project-card-placeholder {
    width: 100%;
    height: 100%;
    min-height: 12rem;
  }

  .project-card-image {
    display: block;
    object-fit: cover;
    object-position: var(--project-card-image-position);
    transition: transform 240ms ease;
    will-change: transform;
  }

  .project-card:hover .project-card-image {
    transform: scale(1.04);
  }

  .project-card-placeholder {
    background: linear-gradient(
      135deg,
      var(--project-card-accent),
      var(--project-card-accent-secondary)
    );
  }

  .project-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
  }

  .project-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card-title-group {
    display: grid;
    gap: 0.25rem;
  }

  .project-card-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--project-card-accent) 84%, white);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .project-card-title {
    margin: 0;
    color: var(--project-card-accent);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .project-card-date,
  .project-card-pill {
    flex-shrink: 0;
    border-radius: 0.375rem;
    background: var(--surface-color);
    padding: 0.45rem 0.55rem;
    color: color-mix(in srgb, var(--project-card-accent-secondary) 80%, white);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
  }

  .project-card-copy {
    margin: 0;
    line-height: 1.65;
  }

  .project-card-feature {
    border-color: var(--project-card-accent);
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--project-card-accent) 24%, transparent),
        transparent 50%
      ),
      linear-gradient(
        170deg,
        color-mix(
          in srgb,
          var(--project-card-accent-secondary) 16%,
          transparent
        ),
        transparent 72%
      ),
      var(--surface-hover);
  }

  .project-card-quiet {
    border-color: color-mix(
      in srgb,
      var(--project-card-accent) 36%,
      var(--highlight)
    );
  }

  .project-card-maid-moving-boxes {
    position: relative;
    border-color: #ffd166;
    background:
      linear-gradient(90deg, #ff6f9129, transparent 45%),
      linear-gradient(135deg, #2a1524, #151018 72%);
    box-shadow: inset 0 0 0 1px #ffffff1f;
  }

  .project-card-maid-moving-boxes::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(
        90deg,
        transparent 0 12px,
        #ffffff12 12px 14px,
        transparent 14px 28px
      ),
      linear-gradient(
        0deg,
        transparent 0 12px,
        #ffffff0f 12px 14px,
        transparent 14px 28px
      );
    opacity: 0.25;
    pointer-events: none;
  }

  .project-card-maid-moving-boxes .project-card-eyebrow {
    color: #ffe7a8;
  }

  .project-card-maid-moving-boxes .project-card-date,
  .project-card-maid-moving-boxes .project-card-pill {
    background: #2d1822;
    color: #ffe7a8;
  }

  .project-card-floating-fuzzies .project-card-media {
    background:
      radial-gradient(circle at 20% 20%, #ffffff54, transparent 18%),
      radial-gradient(circle at 80% 70%, #b8f7d452, transparent 24%), #12202a;
  }

  @media (min-width: 768px) {
    .project-card {
      grid-template-columns: minmax(12rem, 18rem) 1fr;
    }

    .project-card-media,
    .project-card-image,
    .project-card-placeholder {
      min-height: 100%;
    }
  }
</style>
